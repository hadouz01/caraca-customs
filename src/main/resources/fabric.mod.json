{
	"schemaVersion": 1,
	"id": "caraca_customs",
	"version": "${version}",
	"name": "Caraca Customs",
	"description": "Custom Poké Balls and Berry systems for Cobblemon.",
	"authors": [
		"hadouz01"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/caraca_customs/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "com.caraca.CaracaCustoms"
			}
		],
		"client": [
			"com.caraca.customs.client.CustomBallTooltipHandler"
		],
		"modmenu": [
			"com.caraca.customs.client.gui.ModMenuIntegration"
		]
	},
	"mixins": [
		"caraca_customs.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"cobblemon": "*"
	}
}